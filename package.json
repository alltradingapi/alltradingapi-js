{
  "name": "alltradingapi",
  "version": "1.0.0",
  "description": "Quotex candles, assets, saved candles, candle history, chart images and trade result checks - zero dependencies, TypeScript.",
  "license": "MIT",
  "author": "All Trading API <admin@alltradingapi.com>",
  "homepage": "https://alltradingapi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alltradingapi/alltradingapi-js.git"
  },
  "bugs": {
    "url": "https://github.com/alltradingapi/alltradingapi-js/issues"
  },
  "keywords": [
    "quotex",
    "trading",
    "api",
    "binary-options",
    "market-data",
    "candles",
    "signals",
    "forex",
    "otc",
    "analysis",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
